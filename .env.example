# API (apps/api). Validated at startup: see apps/api/src/config.ts.
# Must be a NON-superuser role, or row-level security is bypassed.
DATABASE_URL=postgres://mediavault:mediavault@localhost:5432/mediavault
APP_ORIGIN=http://localhost:5174
PUBLIC_API_URL=http://localhost:5174/api
# Generate with: openssl rand -hex 32
SIGNING_SECRET=

# local | s3 (AWS S3, Cloudflare R2, Backblaze B2, Supabase Storage, MinIO)
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

WORKSPACE_QUOTA_BYTES=1073741824
RUN_WORKER_IN_PROCESS=true
DEMO_MODE=true
